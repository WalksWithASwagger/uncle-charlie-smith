# Uncle Charlie site environment contract for agents and local operators.
# Real values belong in user-managed or untracked local value files.
# @import(~/.agents/env/values/.env.shared.local, pick=[ANTHROPIC_API_KEY], allowMissing=true)
# @import(~/.agents/env/values/.env.uncle-charlie.local, pick=[ANTHROPIC_API_KEY, ARCHIVE_PATH], allowMissing=true)
# @defaultRequired=false
# @defaultSensitive=false
# ---

# Anthropic API key for the Ask and press API routes.
# @sensitive
ANTHROPIC_API_KEY=

# Optional path to the archive root used by sync and image build scripts.
# @public
ARCHIVE_PATH=
